{
  "manifest_version": 2,
  "name": "Folder Expand/Collapse All",
  "version": "0.1.5",
  "description": "Expand or collapse all accounts and nested folders in the current mail tab.",
  "browser_specific_settings": {
    "gecko": {
      "id": "folder-controls@franciscoernestoteixeira.github.io",
      "strict_min_version": "157.0",
      "strict_max_version": "158.*"
    }
  },
  "permissions": [
    "menus",
    "notifications"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "commands": {
    "expand-all": {
      "description": "Expand All Folders"
    },
    "collapse-all": {
      "description": "Collapse All Folders"
    }
  },
  "experiment_apis": {
    "folderControls": {
      "schema": "experiments/schema.json",
      "parent": {
        "scopes": [
          "addon_parent"
        ],
        "paths": [
          [
            "folderControls"
          ]
        ],
        "script": "experiments/implementation.js"
      }
    }
  }
}
